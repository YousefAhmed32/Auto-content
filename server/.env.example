CLIENT_ORIGIN=http://localhost:5173
PORT=4000

# أنشئه مرة واحدة: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
CONTACT_EMAIL=hello@example.com

